<main class="mx-auto max-w-md p-8 space-y-6">
  <div class="space-y-1">
    <h1 class="text-2xl text-content-strong">Development Login</h1>
    <p class="text-sm text-content-muted">
      No identity provider is configured. Pick a user to sign in as.
    </p>
  </div>

  <ul class="divide-y divide-hairline rounded-md border border-hairline">
    <li :for={user <- @users} class="flex items-center gap-3 p-3">
      <div class="min-w-0 flex-1">
        <p class="truncate text-content-strong">{user.name}</p>
        <p class="truncate text-sm text-content-muted">{user.email}</p>
        <p class="truncate font-mono text-xs text-content-subtle">{user.sid}</p>
      </div>
      <form action={~p"/dev/login"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input type="hidden" name="token" value={@token} />
        <input type="hidden" name="sid" value={user.sid} />
        <.button variant={:secondary}>Sign In</.button>
      </form>
    </li>
  </ul>

  <form action={~p"/dev/login"} method="post">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <input type="hidden" name="token" value={@token} />
    <input type="hidden" name="sid" value="default" />
    <.button>Sign in as {@dev_email}</.button>
  </form>
</main>
