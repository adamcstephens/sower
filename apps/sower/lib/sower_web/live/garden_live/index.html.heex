<Layouts.app
  flash={@flash}
  current_user={@current_user}
  nav_section={assigns[:nav_section]}
  sidebar_state={assigns[:sidebar_state]}
>
  <.header>
    Listing Gardens
    <:actions>
      <details class="relative">
        <summary
          class="flex list-none cursor-pointer items-center rounded-lg p-2 text-content hover:bg-surface-hover"
          aria-label="Toggle columns"
          title="Columns"
        >
          <.icon name="hero-view-columns" class="h-5 w-5" />
        </summary>
        <ul
          id="garden-column-controls"
          phx-update="ignore"
          class="absolute right-0 top-full z-50 mt-2 w-48 rounded-lg border border-line bg-surface p-2 shadow-lg"
        >
          <li :for={col <- @columns} :if={not col.lockable}>
            <label class="flex items-center gap-2 px-2 py-1 text-sm cursor-pointer hover:bg-surface-hover rounded">
              <input
                type="checkbox"
                checked={col.default}
                data-column-control="gardens"
                data-column={col.key}
                data-column-default={to_string(col.default)}
              />
              {col.label}
            </label>
          </li>
        </ul>
      </details>
    </:actions>
  </.header>

  <.table
    id="gardens"
    rows={@gardens}
    row_click={fn garden -> JS.navigate(~p"/gardens/#{garden}") end}
    meta={@meta}
    path={~p"/gardens"}
    action_hide_on={:sm}
  >
    <:col
      :let={garden}
      :for={col <- @columns}
      label={col.label}
      field={col.sort_field}
      key={col.key}
      default_visible={col.default}
    >
      <%= case col.key do %>
        <% :name -> %>
          {garden.name}
        <% :online -> %>
          <.online state={garden.sid in Map.keys(@garden_presence)} />
        <% :deploy -> %>
          <.result result={garden.latest_deployment && garden.latest_deployment.result} />
        <% :version -> %>
          {garden.version || "—"}
      <% end %>
    </:col>
    <:action :let={garden}>
      <div class="sr-only">
        <.link navigate={~p"/gardens/#{garden}"}>Show</.link>
      </div>
    </:action>
  </.table>

  <.pagination meta={@meta} path={~p"/gardens"} />

  <.modal
    :if={@live_action in [:new, :edit]}
    id="garden-modal"
    show
    on_cancel={JS.patch(~p"/gardens")}
  >
    <.live_component
      module={SowerWeb.GardenLive.FormComponent}
      id={@garden.id || :new}
      title={@page_title}
      action={@live_action}
      garden={@garden}
      patch={~p"/gardens"}
    />
  </.modal>
</Layouts.app>
