+/// Return the host-visible output path for metadata reads. Rootless Nix has
+/// a private `/nix/store` mapped from the agent's data directory.
+pub(crate) fn store_path_on_host(
+  rootless: bool,
+  store_path: &str,
+) -> color_eyre::Result<PathBuf> {
+  if !rootless {
+    return Ok(PathBuf::from(store_path));
+  }
+  let path = std::path::Path::new(store_path);
+  if path.parent() != Some(std::path::Path::new("/nix/store")) {
+    return Err(color_eyre::eyre::eyre!("invalid output store path: {store_path}"));
+  }
+  #[cfg(target_os = "linux")]
+  {
+    return Ok(data_dir()?.join("store").join(path.file_name().ok_or_else(|| {
+      color_eyre::eyre::eyre!("output store path has no filename")
+    })?));
+  }
+  #[cfg(not(target_os = "linux"))]
+  {
+    Err(color_eyre::eyre::eyre!("rootless agent mode requires Linux"))
   }
 }
 
